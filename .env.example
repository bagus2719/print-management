# Flask Secret Keys (Generate dengan: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=ganti-dengan-secret-key-acak-32-karakter
WTF_CSRF_SECRET_KEY=ganti-dengan-csrf-key-acak-32-karakter

# Mode Aplikasi
FLASK_DEBUG=false

# Konfigurasi Midtrans Payment Gateway
# Dapatkan keys dari https://dashboard.midtrans.com
MIDTRANS_MERCHANT_ID=your-midtrans-merchant-id
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key

# Set 'true' jika sudah di production environment, 'false' untuk sandbox/testing
MIDTRANS_IS_PRODUCTION=false

